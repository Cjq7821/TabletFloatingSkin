<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:tools="http://schemas.android.com/tools">

	<!-- Android 11+ 包可见性：允许查询 Poweramp 的 API intent -->
	<queries>
		<intent>
			<action android:name="com.maxmpz.audioplayer.API_COMMAND"/>
		</intent>
	</queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/app_icon"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
	    tools:ignore="GoogleAppIndexingWarning">

	    <!-- 皮肤声明入口：Poweramp 通过该 meta-data 发现本应用提供的皮肤 -->
        <meta-data android:name="com.maxmpz.PowerampSkins" android:resource="@xml/skins"/>

        <activity android:name=".SkinInfoActivity"
	        android:exported="true"
	        >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
	            <!-- 皮肤类插件应用建议声明该 action，便于 Poweramp 发现皮肤 -->
	            <action android:name="com.maxmpz.audioplayer.SKIN_MAIN" />
            </intent-filter>
        </activity>
    </application>

</manifest>
